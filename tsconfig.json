{
    "compilerOptions": 
      {
    "target": "ES2022",
    "module": "none",
    "ignoreDeprecations": "6.0",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true
      },
    "include": 
      [
    "src/**/*.ts"
  ]
}
